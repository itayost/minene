{
  "name": "multi-brand-content-viewer",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "validate:brands": "tsx scripts/validate-brands.ts",
    "validate:lab": "tsx scripts/validate-lab-content.ts",
    "export:dataset": "tsx scripts/export-dataset.ts",
    "report:techniques": "tsx scripts/technique-report.ts",
    "report:experiment": "tsx scripts/experiment-report.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ci": "biome ci . && tsc --noEmit && vitest run",
    "build": "pnpm validate:brands && tsc --noEmit && next build",
    "check": "pnpm test:run && pnpm build",
    "visual:reference": "echo 'Frozen. These references were captured from the Vite build, which no longer exists: Task 5 deleted it, and the shell controls are now anchors rather than buttons, so click mode can no longer reproduce them. They were produced with: VIEWER_MODE=click playwright test --update-snapshots. They cannot be regenerated, so an overwrite can only be recovered with git restore tests/visual/__snapshots__. Use pnpm visual:verify to compare against them.' && exit 1",
    "visual:verify": "VIEWER_MODE=url playwright test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/openai": "^4.0.50",
    "@fontsource-variable/heebo": "^5.3.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "ai": "^7.0.83",
    "next": "16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
