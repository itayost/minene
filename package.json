{
  "name": "multi-brand-content-viewer",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "validate:brands": "tsx scripts/validate-brands.ts",
    "test": "vitest --exclude tests/visual",
    "test:run": "vitest run --exclude tests/visual",
    "build": "pnpm validate:brands && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "pnpm test:run && pnpm build",
    "visual:reference": "VIEWER_MODE=click playwright test --update-snapshots",
    "visual:verify": "VIEWER_MODE=url playwright test"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
