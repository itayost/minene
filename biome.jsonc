{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",

  // jsonc rather than json so the two rule decisions below can carry their
  // reasons. A disabled lint rule with no explanation is indistinguishable
  // from one somebody turned off to make a red build go green.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      // Frozen references captured from a Vite build that no longer exists.
      // They cannot be regenerated -- see the visual:reference script.
      "!tests/visual/__snapshots__",
      // A vendored design reference, not our source.
      "!minene-app-page-redesign",
      // Tool state, and content data read at runtime. Reformatting either only
      // produces churn in diffs nobody reads.
      "!.impeccable",
      "!content",
      // Next 16 rewrites this file on every build, so formatting it is a change
      // that undoes itself.
      "!tsconfig.json"
    ]
  },

  // Single quotes and no semicolons because that is what the larger and newer
  // half of the codebase already does. The formatter ratifies the majority
  // style rather than imposing a third one: src/brain had 1 semicolon-
  // terminated line in 2041, src/persuade had 684 in 4215, and that split is
  // the seam where eran-presueder was merged in.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        // Off deliberately. It fired 51 times: 44 in tests, where asserting a
        // fixture exists is exactly what `!` is for, and the rest are guarded
        // reads that already say why in a comment -- supabase.ts asserts
        // process.env only after isStorageConfigured() has returned true.
        // Rewriting 51 call sites to satisfy a style rule would be a large
        // diff that makes no code safer.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // Off. All six sites are test doubles that implement `then` on purpose:
        // Supabase's query builder is thenable, so a fake that is not cannot be
        // awaited the way the real client is. The rule is right in general and
        // wrong about a deliberate mock of a thenable API.
        "noThenProperty": "off",

        // Demoted, not fixed. Four sites, all lists whose items have no stable
        // id to key on -- conversation turns, menu rows. Keying them properly
        // means giving those items ids, which is a data change, not a lint fix.
        "noArrayIndexKey": "info"
      },
      "performance": {
        // Demoted. Seven <img> elements that next/image would replace. That is
        // a real rendering change with its own layout and loading behaviour,
        // and it does not belong in the commit that installs the linter.
        "noImgElement": "info"
      },
      "complexity": {
        // Demoted. Six `!important` declarations in styles.css. Removing them
        // means untangling the cascade that made them necessary -- worth doing,
        // separately, with the visual snapshots to check it against.
        "noImportantStyles": "info"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
