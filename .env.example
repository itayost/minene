# Public browser configuration. Both values are safe to ship to the client:
# the publishable key identifies the project and is gated by row-level security.
# A service-role key must never appear in this repository.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Server-only, and minene's first. The persuasion engine calls a model from
# route handlers; this must never appear in the frontend host's public
# environment panel, where NEXT_PUBLIC_ values belong.
OPENAI_API_KEY=<redacted>

# The persuader reads and writes conversations with the service key rather than
# the caller's session, because it writes rows on the assignee's behalf.
SUPABASE_URL=<redacted>
SUPABASE_SECRET_KEY=<redacted>

# The local drafting path, which has no session and no assignment. It must never
# be true in a deploy that shop-floor staff can reach.
PERSUADER_ALLOW_ANONYMOUS=false

# Required by the run store's default context. Without it every saveRun throws
# and the throw is swallowed, so simulations appear to succeed and persist
# nothing -- which is also why the matrix would have no data to draw.
PERSUADER_TENANT_ID=<redacted>

# How long each role is allowed to think, and how long each may write. Both are
# defaults set in code -- these exist so a conversation that starts reading as
# hurried can be tuned back up without a deploy. All optional.
#
# The two roles someone is waiting on default to a short thinking budget: on a
# reasoning model that budget is most of the wait between pressing שליחה and a
# message appearing, and this engine's hard thinking is deterministic code
# anyway. Raise these before reaching for a bigger model.
#
# PERSUADER_EFFORT=low            # every turn of every conversation
# PERSUADER_PLANNER_EFFORT=low    # stage 0, now built once per assignment
# PERSUADER_TARGET_EFFORT=minimal # the simulated counterpart in the lab
#
# The models themselves, if the defaults in lib/model.ts are ever wrong for a
# deployment. Changing the planner invalidates every cached plan on its own:
# the model id is part of the fingerprint rows are keyed by.
#
# PERSUADER_MODEL=
# PERSUADER_PLANNER_MODEL=
# PERSUADER_TARGET_MODEL=
